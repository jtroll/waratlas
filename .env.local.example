# --- Mapbox ---------------------------------------------------------------
# Public Mapbox access token. Visible in the browser by design (Mapbox uses
# domain-restricted public tokens).
#
# IMPORTANT before deploying publicly:
#   1. Create a token at https://account.mapbox.com/access-tokens/
#   2. Restrict it to your production domain (URL allowlist) in the Mapbox UI.
#      Without this, anyone can copy the token from your site's network tab
#      and bill traffic to your account.
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your_mapbox_public_token_here

# --- Site URL -------------------------------------------------------------
# Used by robots.ts, sitemap.ts, and metadataBase for OG/Twitter card URLs.
# Set this in your Vercel project settings, not just locally.
NEXT_PUBLIC_BASE_URL=https://wars-atlas.example

# --- Feedback channel (optional) -----------------------------------------
# Where the "Corrections & feedback" link in AboutModal points. Defaults to
# a placeholder GitHub issues URL if unset.
# NEXT_PUBLIC_FEEDBACK_URL=https://github.com/your-org/wars-atlas/issues
